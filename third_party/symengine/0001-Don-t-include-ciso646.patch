From 4a2c6c1971906b8f0b2244fd98e712f37084c6ab Mon Sep 17 00:00:00 2001
From: Austin Schuh <austin.linux@gmail.com>
Date: Wed, 11 Nov 2026 23:40:10 -0800
Subject: [PATCH] Don't include <ciso646>

C++ has and, or and not as keywords, so <ciso646> does nothing, and
libstdc++ 15 warns that it isn't a standard header since C++20.
---
 symengine/prime_sieve.cpp | 1 -
 symengine/symengine_rcp.h | 1 -
 2 files changed, 2 deletions(-)

diff --git a/symengine/prime_sieve.cpp b/symengine/prime_sieve.cpp
index 22058a2..f9339d5 100644
--- a/symengine/prime_sieve.cpp
+++ b/symengine/prime_sieve.cpp
@@ -1,5 +1,4 @@
 #include <symengine/prime_sieve.h>
-#include <ciso646>
 #include <cmath>
 #include <valarray>
 #include <algorithm>
diff --git a/symengine/symengine_rcp.h b/symengine/symengine_rcp.h
index c49720a..83379d7 100644
--- a/symengine/symengine_rcp.h
+++ b/symengine/symengine_rcp.h
@@ -5,7 +5,6 @@
 #include <cstddef>
 #include <stdexcept>
 #include <string>
-#include <ciso646>
 
 #include <symengine/symengine_config.h>
 #include <symengine/symengine_assert.h>
