diff --git a/absl/log/internal/check_op.cc b/absl/log/internal/check_op.cc
--- a/absl/log/internal/check_op.cc
+++ b/absl/log/internal/check_op.cc
@@ -31,6 +31,37 @@
 #include <strings.h>  // for strcasecmp, but msvc does not have this header
 #endif
 
+#if defined(_WIN32)
+extern "C" void aos_FatalUnsetRealtimePriority_default_check_op() {}
+extern "C" void aos_FatalUnsetRealtimePriority();
+#pragma comment(linker, "/alternatename:aos_FatalUnsetRealtimePriority=aos_FatalUnsetRealtimePriority_default_check_op")
+
+static void MaybeUnsetRealtime() { aos_FatalUnsetRealtimePriority(); }
+#elif defined(__APPLE__)
+// Mach-O has no undefined-weak-resolves-to-null, so the ELF form below fails to
+// link when AOS isn't present.  Fall back to a weak definition, which Mach-O
+// does support.  That reintroduces the shadowing hazard the ELF comment
+// describes, which is acceptable here only because macOS is not a realtime
+// target -- realtime_darwin.cc is stubs.
+extern "C" void aos_FatalUnsetRealtimePriority();
+extern "C" __attribute__((weak)) void aos_FatalUnsetRealtimePriority() {}
+
+static void MaybeUnsetRealtime() { aos_FatalUnsetRealtimePriority(); }
+#else
+// Declared weak, and deliberately NOT defined.  A weak *definition* here would
+// be picked over AOS's real one whenever this object comes first in the link or
+// dynamic search order, silently turning the drop back into a no-op.  An
+// undefined weak reference is instead null when AOS is not linked in at all,
+// which is the fallback we actually want.
+extern "C" __attribute__((weak)) void aos_FatalUnsetRealtimePriority();
+
+static void MaybeUnsetRealtime() {
+  if (aos_FatalUnsetRealtimePriority != nullptr) {
+    aos_FatalUnsetRealtimePriority();
+  }
+}
+#endif
+
