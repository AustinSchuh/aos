 void RawLogVA(absl::LogSeverity severity, const char* file, int line,
               const char* format, va_list ap) {
+  // Get off the realtime scheduler before formatting and writing the message,
+  // so a dying process does not do that work at a priority which preempts
+  // healthy realtime applications.  This path aborts without going through
+  // LogMessage, so it needs its own hook.
+  if (severity == absl::LogSeverity::kFatal) {
+    MaybeUnsetRealtime();
+  }
