+    # Objective-C and Objective-C++.  Bazel's objc_library rule refuses to
+    # build unless the toolchain declares these actions, and clang compiles
+    # them with the same driver and the same flags as C/C++ -- the language is
+    # selected from the source file extension.
+    objc_compile = action_config(
+        action_name = ACTION_NAMES.objc_compile,
+        enabled = True,
+        tools = [
+            tool(
+                path = cc,
+            ),
+        ],
+        implies = compile_implies,
+    )
+    action_configs.append(objc_compile)
+
+    objcpp_compile = action_config(
+        action_name = ACTION_NAMES.objcpp_compile,
+        enabled = True,
+        tools = [
+            tool(
+                path = cc,
+            ),
+        ],
+        implies = compile_implies,
+    )
+    action_configs.append(objcpp_compile)
+
