# Description:
#   Rust flatbuffer rules.
#
# Each language wrapper lives in its own file because a load() is
# unconditional: putting this next to flatbuffer_cc_library would force every
# C++-only consumer to have rules_rust visible just to parse the file. That
# is what stopped rules_rust from being a dev_dependency.

"""Rust flatbuffer rules."""

load("@aos//tools/build_rules:clean_dep.bzl", "clean_dep")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("@rules_rust//rust:rust_common.bzl", "CrateInfo")
load(
    ":defs.bzl",
    "DEFAULT_FLATC_RUST_ARGS",
    "DEFAULT_INCLUDE_PATHS",
    "FlatbufferLibraryInfo",
    "flatbuffer_library_public",
)

def _flatbuffer_rust_lib_gen_impl(ctx):
    # TODO(Brian): I think this needs changes to properly handle multiple .fbs files in a rule.
    uses = []
    for (dep, dep_srcs) in zip(ctx.attr.deps, ctx.attr.dep_srcs):
        for dep_src in dep_srcs[FlatbufferLibraryInfo].srcs.to_list():
            uses.append((dep[CrateInfo].name, dep_src.basename.replace(".fbs", "_generated")))
    lib_rs_content = "\n".join(
        [
            "// Automatically generated by the Flatbuffers Bazel rules. Do not modify",
            "#![allow(unused_imports)]",
        ] + ["use %s as %s;" % (crate, use_as) for (crate, use_as) in uses] +
        ["include!(\"%s\");" % src.basename for src in ctx.files.srcs_lib],
    )
    output = ctx.actions.declare_file(ctx.attr.name + "_lib.rs")
    ctx.actions.write(
        output = output,
        content = lib_rs_content,
    )
    return [DefaultInfo(files = depset([output]))]

"""Generates a lib.rs for a flatbuffer_rust_library.

flatc generates individual .rs files for us. It can also generate a top-level mod.rs to be included
in a crate, but that is laid out to include all flatbuffers files in a project. That's not a good
fit for Bazel rules and monorepos, so we generate an alternative that imports all dependencies under
their expected names."""
_flatbuffer_rust_lib_gen = rule(
    implementation = _flatbuffer_rust_lib_gen_impl,
    attrs = {
        "dep_srcs": attr.label_list(mandatory = True, providers = [FlatbufferLibraryInfo], doc = "The _srcs rules for all our direct dependencies"),
        "deps": attr.label_list(mandatory = True, providers = [CrateInfo]),
        "srcs_lib": attr.label(mandatory = True, doc = "The generated srcs for this rule"),
    },
)

def flatbuffer_rust_library(
        name,
        srcs,
        compatible_with = None,
        target_compatible_with = select({
            "//conditions:default": [clean_dep("//tools/platforms/rust:has_support")],
            clean_dep("//tools:has_msan"): ["@platforms//:incompatible"],
        }),
        deps = [],
        include_paths = DEFAULT_INCLUDE_PATHS,
        flatc_args = DEFAULT_FLATC_RUST_ARGS,
        include_reflection = True,
        crate_name = None,
        visibility = None,
        srcs_filegroup_visibility = None):
    includes = [d + "_includes" for d in deps]
    srcs_lib = "%s_srcs" % (name)
    lib_gen = "%s_lib_gen" % (name)
    deps = list(deps)
    if include_reflection:
        deps.append(clean_dep("//aos/flatbuffers/reflection:reflection_rust_fbs"))

    flatbuffer_library_public(
        name = srcs_lib,
        srcs = srcs,
        language_flag = "--rust",
        output_suffix = "_generated.rs",
        deps = includes,
        include_paths = include_paths,
        flatc_args = flatc_args,
        compatible_with = compatible_with,
        target_compatible_with = target_compatible_with,
        visibility = srcs_filegroup_visibility if srcs_filegroup_visibility != None else visibility,
    )
    _flatbuffer_rust_lib_gen(
        name = lib_gen,
        deps = deps,
        dep_srcs = [dep + "_srcs" for dep in deps],
        srcs_lib = srcs_lib,
        visibility = ["//visibility:private"],
        compatible_with = compatible_with,
        target_compatible_with = target_compatible_with,
    )
    rust_library(
        name = name,
        srcs = [srcs_lib, lib_gen],
        crate_root = lib_gen,
        crate_name = crate_name,
        deps = [clean_dep("@aos_flatbuffers//rust:flatbuffers")] + deps,
        edition = "2018",
        visibility = visibility,
        compatible_with = compatible_with,
        target_compatible_with = target_compatible_with,
    )

def _flatbuffer_rust_module_gen_impl(ctx):
    """Runs flatc as upstream does for its own Rust.

    The output is one module tree for the schemas and everything they include.
    """
    out_dir = ctx.actions.declare_directory(ctx.attr.name + "_gen")

    # Schemas include each other by their full path from their module's root, so the include
    # path is the root of each module a schema comes from, source or generated.
    include_dirs = []
    for schema in ctx.files.srcs + ctx.files.includes:
        root = "/".join([p for p in [schema.root.path, schema.owner.workspace_root] if p]) or "."
        if root not in include_dirs:
            include_dirs.append(root)
    args = ctx.actions.args()
    for include_dir in include_dirs:
        args.add("-I", include_dir)
    args.add_all(ctx.attr.flatc_args)
    args.add_all(["--rust", "--gen-all", "--rust-module-root-file"])
    args.add("-o", out_dir.path)
    args.add_all(ctx.files.srcs)
    ctx.actions.run(
        executable = ctx.executable._flatc,
        arguments = [args],
        inputs = ctx.files.srcs + ctx.files.includes,
        outputs = [out_dir],
        mnemonic = "FlatcRustModule",
        progress_message = "Generating Rust for %{label}",
    )

    # The crate root: the module tree's mod.rs, by path.  A module loaded with #[path] is a mod-rs
    # file, so mod.rs's own modules resolve inside the tree.
    lib = ctx.actions.declare_file(ctx.attr.name + "_lib.rs")
    ctx.actions.write(
        output = lib,
        content = "\n".join([
            "// Automatically generated by the Flatbuffers Bazel rules. Do not modify",
            "#![allow(unused_imports, clippy::all)]",
            "#[path = \"%s/mod.rs\"]" % out_dir.basename,
            "mod generated;",
            "pub use generated::*;",
            "",
        ]),
    )
    return [
        DefaultInfo(files = depset([lib, out_dir])),
        OutputGroupInfo(lib = depset([lib]), tree = depset([out_dir])),
    ]

_flatbuffer_rust_module_gen = rule(
    implementation = _flatbuffer_rust_module_gen_impl,
    attrs = {
        "flatc_args": attr.string_list(default = []),
        "includes": attr.label_list(allow_files = [".fbs"], doc = "Schemas srcs include, directly or not"),
        "srcs": attr.label_list(mandatory = True, allow_files = [".fbs"]),
        "_flatc": attr.label(executable = True, cfg = "exec", default = Label("@aos_flatbuffers//:flatc")),
    },
)

def flatbuffer_rust_module_library(
        name,
        srcs,
        includes = [],
        compatible_with = None,
        target_compatible_with = select({
            "//conditions:default": [clean_dep("//tools/platforms/rust:has_support")],
            clean_dep("//tools:has_msan"): ["@platforms//:incompatible"],
        }),
        flatc_args = ["--gen-object-api", "--gen-name-strings"],
        crate_name = None,
        visibility = None):
    """A Rust crate for schemas that include other schemas, generated as upstream generates its own.

    flatbuffer_rust_library makes a crate per schema, whose generated code refers to an included
    schema's types as `crate::<File>_generated::*`.  That can't see a type inside the included
    file's namespace module, so it only works for schemas that include nothing.  Upstream instead
    runs flatc with --gen-all --rust-module-root-file (scripts/generate_code.py): one module tree
    for the schemas and everything they include, with a mod.rs joining each namespace's types into
    one module.  This does the same.

    Args:
      srcs: The schemas to generate for, with everything they include.  With --gen-all, flatc's
        mod.rs only lists the last one's types, so give one schema that includes the rest.
      includes: The schemas srcs include, directly or not, so they're in the sandbox.
      flatc_args: Extra flatc arguments; --rust, --gen-all and --rust-module-root-file are added.
    """
    gen = name + "_gen_rs"
    _flatbuffer_rust_module_gen(
        name = gen,
        srcs = srcs,
        includes = includes,
        flatc_args = flatc_args,
        compatible_with = compatible_with,
        target_compatible_with = target_compatible_with,
        visibility = ["//visibility:private"],
    )
    native.filegroup(
        name = gen + "_lib",
        srcs = [":" + gen],
        output_group = "lib",
        compatible_with = compatible_with,
        target_compatible_with = target_compatible_with,
        visibility = ["//visibility:private"],
    )
    native.filegroup(
        name = gen + "_tree",
        srcs = [":" + gen],
        output_group = "tree",
        compatible_with = compatible_with,
        target_compatible_with = target_compatible_with,
        visibility = ["//visibility:private"],
    )
    rust_library(
        name = name,
        srcs = [":" + gen + "_lib"],
        crate_root = ":" + gen + "_lib",
        compile_data = [":" + gen + "_tree"],
        crate_name = crate_name,
        deps = [clean_dep("@aos_flatbuffers//rust:flatbuffers")],
        edition = "2018",
        visibility = visibility,
        compatible_with = compatible_with,
        target_compatible_with = target_compatible_with,
    )
