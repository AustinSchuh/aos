// A mirror of ProtobufControlData and its dependencies from mrccomm's
// MrcComm.proto, written the way a schema has to be written for the
// reflection translator to reproduce that protobuf.
//
// The ids are the proto's field numbers minus one, since protobuf numbers
// from 1 and flatbuffers from 0.  ControlData reserves id 0 with a deprecated
// field because the proto has no field 1 -- deleted at some point, and the
// hole is worth recording rather than papering over.

namespace aos.testing;

attribute "proto_type";

// mrc.proto.ProtobufFingerData, fields 1..3.
table FingerData {
  x:uint (id: 0);
  y:uint (id: 1);
  down:bool (id: 2);
}

// mrc.proto.ProtobufTouchpadData, field 1.
table TouchpadData {
  fingers:[FingerData] (id: 0);
}

// mrc.proto.ProtobufJoystickData, fields 1..7.
table JoystickData {
  available_buttons:ulong (id: 0);
  buttons:ulong (id: 1);
  available_axes:uint (id: 2);
  // "repeated sint32 Axes" -- zigzag, which flatbuffers has no notion of.
  axes:[int] (id: 3, proto_type: "sint32");
  // POVCount and POVs are the nibble-packed pair from the proto.  Reflection
  // cannot invent that packing, so the schema carries the packed word and the
  // application does the shifting, exactly as the C++ side already does.
  pov_count:uint (id: 4);
  povs:uint (id: 5);
  touchpads:[TouchpadData] (id: 6);
}

// mrc.proto.ProtobufControlData, fields 2..6.
table ControlData {
  // The proto has no field 1.
  reserved_0:byte (id: 0, deprecated);
  match_time:int (id: 1);
  joysticks:[JoystickData] (id: 2);
  current_op_mode:ulong (id: 3, proto_type: "fixed64");
  control_word:uint (id: 4);
  game_data:string (id: 5);
}

root_type ControlData;
